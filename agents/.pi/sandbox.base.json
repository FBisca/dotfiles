{
  "enabled": true,
  "enableAccessRequestTool": true,
  "permissionPromptTimeoutSeconds": 600,
  "network": {
    "allowedDomains": [
      "*"
    ],
    "disabled": true,
    "allowLocalBinding": true,
    "allowSSHAgentSocket": true
  },
  "filesystem": {
    "denyRead": [
      ".env",
      ".env.*",
      "/**.env",
      "/**.env.*",
      "*.pem",
      "*.key",
      "~/.ssh/id_*",
      "~/.aws/credentials",
      "~/.config/gh/hosts.yml",
      "~/.claude/.credentials.json",
      "~/.pi/agent/auth.json"
    ],
    "allowRead": [
      "/Users",
      "/home",
      "/Applications",
      "/Library",
      "/System",
      "/opt",
      "/usr",
      "/etc",
      "/bin",
      "/sbin",
      "/private",
      "/tmp",
      "/var"
    ],
    "allowWrite": [
      "/"
    ],
    "denyWrite": [
      "/**.env",
      "/**.env.*",
      "/**/*.pem",
      "/**/*.key",
      "/**/*.p12",
      "~/.netrc",
      "~/.npmrc",
      "~/.ssh/id_*",
      "~/.aws/credentials",
      "~/.docker/config.json",
      "~/.kube/config",
      "~/.gnupg",
      "~/.config/gh/hosts.yml",
      "~/.claude/.credentials.json",
      "~/.pi/agent/auth.json"
    ]
  }
}
