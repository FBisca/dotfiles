{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "~/.ssh/id_*": "deny",
      "~/.aws/credentials": "deny",
      "~/.netrc": "deny",
      "~/.npmrc": "deny",
      "~/.docker/config.json": "deny",
      "~/.kube/config": "deny",
      "~/.gnupg": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm -r *": "ask",
      "rm -R *": "ask",
      "rm -fR *": "ask",
      "rm -Rf *": "ask",
      "rm -r -f *": "ask",
      "rm -f -r *": "ask",
      "shred *": "ask",
      "sudo *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "diskutil erase*": "ask",
      "diskutil partition*": "ask",
      "diskutil secureErase*": "ask",
      "find * -delete": "ask",
      "rtk find * -delete": "ask",
      "find * -exec *": "ask",
      "rtk find * -exec *": "ask",
      "git push --force*": "ask",
      "git push -f *": "ask",
      "rtk git push --force*": "ask",
      "rtk git push -f *": "ask",
      "git reset --hard*": "ask",
      "rtk git reset --hard*": "ask",
      "git clean -fd*": "ask",
      "git clean -xfd*": "ask",
      "rtk git clean -fd*": "ask",
      "rtk git clean -xfd*": "ask",
      "chmod -R 777 *": "ask",
      "chown -R *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/developer": "allow",
      "~/developer/*": "allow",
      "~/claude": "allow",
      "~/claude/*": "allow",
      "~/ulixee-cloud": "allow",
      "~/ulixee-cloud/*": "allow",
      "~/ocr-test": "allow",
      "~/ocr-test/*": "allow",
      "~/bench-tmp": "allow",
      "~/bench-tmp/*": "allow",
      "~/perf-reviews": "allow",
      "~/perf-reviews/*": "allow",
      "~/.agents": "allow",
      "~/.agents/*": "allow",
      "~/.agent-orchestrator/*": "allow",
      "~/.local/*": "allow",
      "*/.pi/agent/*": "allow",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "/var/folders/*": "allow"
    }
  },
  "promptNotifications": [
    "bell"
  ],
  "promptTimeoutMs": 60000,
  "piInfrastructureReadPaths": [
    "~/.pi/agent/*.json",
    "~/.pi/agent/extensions/*"
  ]
}
