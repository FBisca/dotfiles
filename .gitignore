# Ignore private Git identity overrides
git/.config/git/*/

# [gh]
gh/.config/gh/hosts.yml

# [claude]
agents/.claude/chrome/chrome-native-host

# [codex]
agents/.codex/auth.json
agents/.codex/config.local.toml


# [nvim]
nvim/.config/nvim/lazy-lock.json

# [zsh] Secrets directory containing API tokens
zsh/.zsh/secrets/

.idea/
.DS_Store
agents/.codex/rules/default.rules
# [skills] claude.ai account skills (~/.claude/skills/synced) must never be redistributed (Anthropic license)
synced/
agents/.claude/settings.json.bak-*
agents/.codex/config.toml.bak-*
__pycache__/

# [private] machine/work-only content, never public
zsh/.zsh/private/
