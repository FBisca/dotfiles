{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "enableSkillCommands": true,
  "packages": ["npm:pi-rtk-optimizer@0.9.0", "npm:pi-web-search-lite", "npm:pi-starline", "npm:pi-compact-tools"],
  "defaultProvider": "minimax",
  "defaultModel": "MiniMax-M3.1-Flash",
  "modelThinkingLevels": { "minimax/MiniMax-M3.1-Flash": "max" },
  "defaultTools": ["+tool_search", "+codemode"],
  "codemode": { "mode": "on", "inlineBudget": 3000 }
}
